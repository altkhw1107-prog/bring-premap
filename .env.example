# 공공데이터포털 > 국토교통부 건축HUB 건축물대장정보 서비스 인증키
# 서버에서만 사용하며 브라우저나 Git에 실제 값을 넣지 마세요.
BUILDING_REGISTER_API_KEY=

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
# 서버에서만 사용합니다. JavaScript 키를 넣지 마세요.
KAKAO_REST_API_KEY=

# 생성형 AI 인터뷰용 서버 비밀값입니다. 브라우저에 노출하지 마세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 촬영 사진 분류에 사용하는 멀티모달 모델입니다. API 키는 위 서버 비밀값을 재사용합니다.
GEMINI_VISION_MODEL=gemini-3.6-flash

# 공식 홈페이지 분석용 서버 비밀값입니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Supabase 관리자 로그인 및 서버 저장
# URL과 publishable key는 브라우저에 노출되어도 되지만 환경변수로 관리합니다.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_ADMIN_EMAIL=admin@example.com
# 서버 전용입니다. Git/브라우저/로그에 절대 노출하지 마세요.
SUPABASE_SECRET_KEY=
# AI 검증을 통과한 현장 사진이 저장될 비공개 Storage 버킷입니다.
SUPABASE_PHOTO_BUCKET=diagnosis-photos
